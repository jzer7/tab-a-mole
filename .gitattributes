# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
*                       text=auto
#
# The above will handle all files NOT found below
#
# These files are text and should be normalized (Convert crlf => lf)
*.gitattributes         text
.gitignore              text
*.md                    text diff=markdown
#
# Exclude files from exporting (git archive)
#
.gitattributes          export-ignore
.gitignore              export-ignore
/.devcontainer          export-ignore
/.github                export-ignore
/.vscode                export-ignore
/docs                   export-ignore
#
# Enable syntax highlighting for files with `.gitattributes` extensions.
#
*.gitattributes         linguist-language=gitattributes
*.gitattributes         linguist-detectable
*.gitattributes         -linguist-documentation
#
# This is not our code
vendors/**              linguist-vendored
#
# Apply override to all files in the directory
#
*.md                    linguist-documentation
docs/*                  linguist-documentation
#
# Fix syntax highlighting on GitHub to allow comments
#
.devcontainer/*.json    linguist-language=JSON-with-Comments
.vscode/*.json          linguist-language=JSON-with-Comments
#
# Exclude from stats, and hide in diffs
package-lock.json       linguist-generated diff=nodiff
*.lock                  linguist-generated diff=nodiff
#
# Binary files
#
*.pdf                   filter=lfs diff=lfs merge=lfs -text
*.png                   binary
*.woff                  binary
*.woff2                 binary
*.zip                   binary
