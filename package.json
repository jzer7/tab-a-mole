{
  "$schema": "https://www.schemastore.org/package.json",
  "author": "Me Yo",
  "bugs": {
    "url": "https://github.com/jzer7/tab-a-mole/issues"
  },
  "description": "chrome extension",
  "devDependencies": {
    "@eslint/config-inspector": "^3.1.0",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/bun": "^1.3.14",
    "@types/chrome": "^0.2.2",
    "chrome-types": "^0.1.436",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-security": "^4.0.1",
    "extension": "^4.0.16",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "homepage": "https://github.com/jzer7/tab-a-mole#readme",
  "keywords": [
    "chrome-extension",
    "tab-manager"
  ],
  "license": "MIT",
  "name": "tab-a-mole",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzer7/tab-a-mole.git"
  },
  "scripts": {
    "NOTE": "echo bun has their own commands 'build', 'dev', 'test' which are different than their 'run' scripts",
    "dev": "extension dev --browser chrome",
    "dev:bun": "bun dev",
    "start": "extension start --browser chrome",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write **/*.{md,html,json}",
    "build:bun": "bun build",
    "lint": "eslint '**/*.ts'",
    "lint:fix": "eslint --fix '**/*.ts'",
    "build": "extension build --browser chrome",
    "package": "extension build --zip",
    "prepare": "husky",
    "preview": "extension preview"
  },
  "type": "module",
  "version": "2.0.2",
  "lint-staged": {
    "**/*.{css,html,json,md}": [
      "prettier --write"
    ],
    "**/*.{js,cjs,mjs,ts}": [
      "eslint --fix"
    ]
  }
}
