{
  "$schema": "https://www.schemastore.org/package.json",
  "author": "Me Yo",
  "bugs": {
    "url": "https://github.com/jzer7/tab-a-mole/issues"
  },
  "description": "chrome extension",
  "devDependencies": {
    "@eslint/config-inspector": "^1.4.2",
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@types/bun": "^1.3.10",
    "@types/chrome": "^0.1.37",
    "chrome-types": "^0.1.420",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "extension": "^3.8.7",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "homepage": "https://github.com/jzer7/tab-a-mole#readme",
  "keywords": [
    "chrome-extension",
    "tab-manager"
  ],
  "license": "MIT",
  "name": "tab-a-mole",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzer7/tab-a-mole.git"
  },
  "scripts": {
    "dev": "extension dev --browser chrome",
    "dev:bun": "bun dev",
    "start": "extension start --browser chrome",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write **/*.{md,html,json}",
    "build:bun": "bun build",
    "lint": "eslint '**/*.js'",
    "lint:fix": "eslint --fix '**/*.js'",
    "build": "extension build --browser chrome",
    "package": "extension build --zip",
    "prepare": "husky",
    "preview": "extension preview"
  },
  "type": "module",
  "version": "1.0.1",
  "lint-staged": {
    "**/*.{css,html,json,md}": [
      "prettier --write"
    ],
    "**/*.{js,cjs,mjs,ts}": [
      "eslint --fix"
    ]
  }
}
