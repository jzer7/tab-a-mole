{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "tab-a-mole",
  "description": "chrome extension",
  "author": "Me Yo",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "keywords": [
    "chrome-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzer7/tab-a-mole.git"
  },
  "bugs": {
    "url": "https://github.com/jzer7/tab-a-mole/issues"
  },
  "homepage": "https://github.com/jzer7/tab-a-mole#readme",
  "scripts": {
    "build": "extension build --browser chrome",
    "dev": "extension dev",
    "preview": "extension preview",
    "prettier": "npx prettier **/*.{md,html,json} -w",
    "lint": "eslint '**/*.js'",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "husky",
    "package": "extension build --zip",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@eslint/config-inspector": "^1.2.0",
    "@eslint/js": "^9.35.0",
    "@types/chrome": "^0.1.11",
    "babel-jest": "^30.1.2",
    "chrome-types": "^0.1.375",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "extension": "^2.1.3",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^27.5.1",
    "jest-chrome": "^0.8.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "**/*.js": [
      "npx eslint --fix"
    ],
    "**/*.{md,html,json}": [
      "npx prettier --write"
    ]
  }
}
