{
  "testEnvironment": "node",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/?(*.)+(test).[jt]s"],
  "moduleFileExtensions": ["js", "json"],
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
  "collectCoverage": true,
  "coverageDirectory": "coverage",
  "coverageReporters": ["text", "lcov"],
  "transform": {
    "^.+\\.js$": "babel-jest"
  },
  "verbose": true
}
