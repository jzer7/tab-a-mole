{
  "$schema": "https://www.schemastore.org/package.json",
  "author": "Me Yo",
  "bugs": {
    "url": "https://github.com/jzer7/tab-a-mole/issues"
  },
  "description": "chrome extension",
  "devDependencies": {
    "@eslint/config-inspector": "3.5.0",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/markdown": "8.0.3",
    "@types/bun": "1.4.4",
    "@types/chrome": "0.3.7",
    "chrome-types": "0.1.461",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-security": "4.2.1",
    "extension": "4.1.37",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "homepage": "https://github.com/jzer7/tab-a-mole#readme",
  "keywords": [
    "chrome-extension",
    "tab-manager"
  ],
  "license": "MIT",
  "name": "tab-a-mole",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzer7/tab-a-mole.git"
  },
  "scripts": {
    "NOTE": "echo bun has their own commands 'build', 'dev', 'test' which are different than their 'run' scripts",
    "dev": "extension dev --browser chromium",
    "dev:bun": "bun dev",
    "start": "extension start --browser chromium",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write **/*.{md,html,json}",
    "lint": "eslint '**/*.ts'",
    "lint:fix": "eslint --fix '**/*.ts'",
    "build": "extension build --browser chromium",
    "package": "extension build --zip",
    "prepare": "husky",
    "preview": "extension preview"
  },
  "type": "module",
  "version": "2.1.3",
  "lint-staged": {
    "**/*.{css,html,json,md}": [
      "prettier --write"
    ],
    "**/*.{js,cjs,mjs,ts}": [
      "eslint --fix"
    ]
  }
}
