{
  "$schema": "https://www.schemastore.org/prettierrc.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "proseWrap": "preserve",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "none",
  "overrides": [
    {
      "files": [".devcontainer/*.json", ".vscode/*.json"],
      "options": {
        "trailingComma": "es5"
      }
    },
    {
      "files": "*.md",
      "options": {
        "parser": "markdown"
      }
    },
    {
      "files": ["*.ts", "*.tsx"],
      "options": {
        "parser": "typescript"
      }
    }
  ]
}
