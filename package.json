{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "tab-a-mole",
  "description": "chrome extension",
  "author": "Me Yo",
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "keywords": [
    "chrome-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jzer7/tab-a-mole.git"
  },
  "bugs": {
    "url": "https://github.com/jzer7/tab-a-mole/issues"
  },
  "homepage": "https://github.com/jzer7/tab-a-mole#readme",
  "scripts": {
    "dev": "extension dev",
    "start": "extension start --browser chrome",
    "build": "extension build --browser chrome",
    "preview": "extension preview",
    "package": "extension build --zip",
    "prettier": "prettier **/*.{md,html,json}",
    "prettier:fix": "prettier **/*.{md,html,json} -w",
    "lint": "eslint '**/*.js'",
    "lint:fix": "eslint '**/*.js' --fix",
    "prepare": "husky",
    "dev:bun": "bun dev",
    "build:bun": "bun build"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@eslint/config-inspector": "^1.3.0",
    "@eslint/css": "^0.11.0",
    "@eslint/js": "^9.36.0",
    "@eslint/json": "^0.13.2",
    "@eslint/markdown": "^7.2.0",
    "@types/bun": "latest",
    "@types/chrome": "^0.1.12",
    "chrome-types": "^0.1.377",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "extension": "^2.1.3",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.44.0"
  },
  "lint-staged": {
    "**/*.js": [
      "eslint --fix"
    ],
    "**/*.{md,html,json}": [
      "prettier --write"
    ]
  }
}