{
  "$schema": "https://www.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "Tab-a-mole",
  "version": "1.0",
  "description": "Find and close duplicate tabs.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/mini-square-16.png",
      "32": "images/mini-square-32.png",
      "48": "images/mini-square-48.png",
      "128": "images/mini-square-128.png"
    }
  },
  "icons": {
    "16": "images/mini-square-16.png",
    "32": "images/mini-square-32.png",
    "48": "images/mini-square-48.png",
    "128": "images/mini-square-128.png"
  }
}
