// https://github.com/DavidAnson/markdownlint-cli2#configuration
{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    // MD003: Header style (heading-style)
    "MD003": {
      "style": "atx"
    },
    // MD012: Multiple consecutive blank lines (no-multiple-blanks)
    "MD012": {
      "maximum": 2
    },
    // MD013: Line length (line-length)
    "MD013": {
      "line_length": 90,
      "code_blocks": false,
      "tables": false
    },
    // MD022: Headings should be surrounded by blank lines (blank-around-heading)
    "MD022": false,
    // MD029: Ordered list item prefix (ol-prefix)
    "MD029": {
      "style": "one_or_ordered"
    },
    // MD033: Inline HTML (no-inline-html)
    "MD033": {
      "allowed_elements": ["br", "details", "div", "img", "summary"]
    }
  },
  "overrides": [
    {
      "filter": ["CHANGELOG.md"],
      "config": {
        // MD024: Multiple headings with the same content (no-duplicate-heading)
        "MD024": {
          "siblings_only": true
        }
      },
      "combine": "merge"
    }
  ]
}
