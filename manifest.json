{
  "$schema": "https://www.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "Tab-a-mole",
  "version": "2.1.0",
  "description": "Helps you manage your large collection of tabs.",
  "homepage_url": "https://github.com/jzer7/tab-a-mole",
  "permissions": ["storage", "tabs", "tabGroups", "sidePanel"],
  "background": {
    "service_worker": "background/background.ts"
  },
  "action": {
    "default_title": "Tab-a-mole - manage a pile of tabs",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "images/banned_stack-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "icons": {
    "128": "images/banned_stack-128.png",
    "48": "images/banned_stack-48.png",
    "32": "images/banned_stack-32.png",
    "16": "images/banned_stack-16.png"
  }
}
